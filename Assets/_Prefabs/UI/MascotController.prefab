    \u041F\u0440\u043E\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F.
    \n\r\n\u041C\u044B \u0443\u0436\u0435 17 \u043B\u0435\u0442 \u0431\u044B\u0441\u0442\u0440\u043E
    \u0438 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E \n\u043F\u0440\u043E\u0435\u043A\u0442\u0438\u0440\u0443\u0435\u043C
    \u043C\u043D\u043E\u0433\u043E\u043A\u0432\u0430\u0440\u0442\u0438\u0440\u043D\u044B\u0435
    \u0434\u043E\u043C\u0430\n \u0438 \u0433\u043E\u0440\u0434\u0438\u043C\u0441\u044F
    \u043A\u0430\u0436\u0434\u044B\u043C \u0441\u0432\u043E\u0438\u043C \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u043C.\r\n\u041F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u043C
    \u0442\u0435\u0431\u0435 \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
    \u0441\u0435\u0431\u044F \u0447\u0430\u0441\u0442\u044C\u044E \n\u043A\u043E\u043C\u0430\u043D\u0434\u044B
    \u0421\u0438\u0431\u0422\u0435\u0445\u041F\u0440\u043E\u0435\u043A\u0442\u0430
    \u0438 \n\u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C \u0441\u043F\u0440\u043E\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C
