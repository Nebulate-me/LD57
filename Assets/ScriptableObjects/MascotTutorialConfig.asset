  - phrase: "\u041A\u043E\u043C\u043D\u0430\u0442\u044B \u0441\u0442\u044B\u043A\u0443\u044E\u0442\u0441\u044F
      \u0434\u0440\u0443\u0433 \u0441 \u0434\u0440\u0443\u0433\u043E\u043C \u0441
      \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0434\u0432\u0435\u0440\u0435\u0439.
      \r\n\u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u043A\u0440\u0443\u0442\u0438\u0442\u044C
      \u043A\u043E\u043C\u043D\u0430\u0442\u0443 \u043A\u043E\u043B\u0435\u0441\u0438\u043A\u043E\u043C
      \u043C\u044B\u0448\u0438, \n\u0447\u0442\u043E\u0431\u044B \u0432\u044B\u0431\u0440\u0430\u0442\u044C
      \u043D\u0443\u0436\u043D\u043E\u0435 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435."
