  - phrase: "\u0412\u043D\u0438\u0437\u0443 \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u044E\u0442\u0441\u044F
      \u043A\u0430\u0440\u0442\u044B \u0441 \u0440\u0430\u0437\u043D\u044B\u043C\u0438
      \u0442\u0438\u043F\u0430\u043C\u0438 \u043A\u043E\u043C\u043D\u0430\u0442,
      \n\u0438\u0437 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C
      \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0443.
      \n\u041A\u0430\u0440\u0442\u044B \u0432\u044B\u043F\u0430\u0434\u0430\u044E\u0442
      \u0432 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u043C \u043F\u043E\u0440\u044F\u0434\u043A\u0435."
