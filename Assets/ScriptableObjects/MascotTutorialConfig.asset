  steps:
  - phrase: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
      \u0432 \u0438\u0433\u0440\u0443 \u0421\u0438\u0431\u0422\u0435\u0445\u041F\u0440\u043E\u0435\u043A\u0442!
      \n\u0421\u0438\u0431\u0422\u0435\u0445\u041F\u0440\u043E\u0435\u043A\u0442
      - \u044D\u0442\u043E \u0421\u0438\u0431\u0438\u0440\u0441\u043A\u0438\u0435
      \u0422\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0438 \u041F\u0440\u043E\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F."
    targetType: 0
    topPanelTargetType: 0
    bottomPanelTargetType: 0
    bottomPanelTargetRoom: {fileID: 0}
    buildingTargetType: 0
    bottomLeftTargetCoordinate: {x: 0, y: 0}
    topRightTargetCoordinate: {x: 0, y: 0}
    actionType: 1
    selectedRoomCard: {fileID: 0}
    roomPosition: {x: 0, y: 0}
  - phrase: "\u041C\u044B 17 \u043B\u0435\u0442 \u0431\u044B\u0441\u0442\u0440\u043E
      \u0438 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E \u043F\u0440\u043E\u0435\u043A\u0442\u0438\u0440\u0443\u0435\u043C
      \u043C\u043D\u043E\u0433\u043E\u043A\u0432\u0430\u0440\u0442\u0438\u0440\u043D\u044B\u0435\n\u0434\u043E\u043C\u0430
      \u0438 \u0433\u043E\u0440\u0434\u0438\u043C\u0441\u044F \u043A\u0430\u0436\u0434\u044B\u043C
      \u0441\u0432\u043E\u0438\u043C \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u043C."
    targetType: 0
    topPanelTargetType: 0
    bottomPanelTargetType: 0
    bottomPanelTargetRoom: {fileID: 0}
    buildingTargetType: 0
    bottomLeftTargetCoordinate: {x: 0, y: 0}
    topRightTargetCoordinate: {x: 0, y: 0}
    actionType: 1
    selectedRoomCard: {fileID: 0}
    roomPosition: {x: 0, y: 0}
  - phrase: "\u041F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0439 \u0441\u0435\u0431\u044F
      \u0447\u0430\u0441\u0442\u044C\u044E \u043A\u043E\u043C\u0430\u043D\u0434\u044B
      \u0421\u0438\u0431\u0422\u0435\u0445\u041F\u0440\u043E\u0435\u043A\u0442\u0430
      \n\u0438 \u0441\u043F\u0440\u043E\u0435\u043A\u0442\u0438\u0440\u0443\u0439
      \u0441\u0432\u043E\u0439 \u043C\u043D\u043E\u0433\u043E\u043A\u0432\u0430\u0440\u0442\u0438\u0440\u043D\u044B\u0439
      \u0434\u043E\u043C."
    targetType: 0
    topPanelTargetType: 0
    bottomPanelTargetType: 0
    bottomPanelTargetRoom: {fileID: 0}
    buildingTargetType: 0
    bottomLeftTargetCoordinate: {x: 0, y: 0}
    topRightTargetCoordinate: {x: 0, y: 0}
    actionType: 1
    selectedRoomCard: {fileID: 0}
    roomPosition: {x: 0, y: 0}
  - phrase: "\u0422\u0432\u043E\u044F \u0437\u0430\u0434\u0430\u0447\u0430 - \u0437\u0430
      10 \u043C\u0438\u043D\u0443\u0442 \u0440\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u0442\u044C
      \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E \n\u0431\u043E\u043B\u044C\u0448\u0435
      \u043A\u0432\u0430\u0440\u0442\u0438\u0440 \u0432 \u043C\u043D\u043E\u0433\u043E\u043A\u0432\u0430\u0440\u0442\u0438\u0440\u043D\u043E\u043C
      \u0434\u043E\u043C\u0435 \n\u043F\u043E \u0437\u0430\u0434\u0430\u043D\u0438\u044E
      \u0437\u0430\u043A\u0430\u0437\u0447\u0438\u043A\u0430."
    targetType: 1
    topPanelTargetType: 1
    bottomPanelTargetType: 0
    bottomPanelTargetRoom: {fileID: 0}
