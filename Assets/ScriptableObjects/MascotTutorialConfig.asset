  - phrase: "\u041E\u043A\u043D\u0430 \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
      \u0432 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u043E\u0439
      \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438,
      \n\u0435\u0441\u043B\u0438 \u043E\u043D\u0430 \u043F\u0440\u0438\u043C\u044B\u043A\u0430\u0435\u0442
      \u043A \u0432\u043D\u0435\u0448\u043D\u0435\u0439 \u0441\u0442\u0435\u043D\u0435
      \u0434\u043E\u043C\u0430."
    targetType: 3
    topPanelTargetType: 0
    bottomPanelTargetType: 0
