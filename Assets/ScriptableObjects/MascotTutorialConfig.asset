  - phrase: "\u041A\u0430\u0436\u0434\u0430\u044F \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0430
      \u0434\u043E\u043B\u0436\u043D\u0430 \u0438\u043C\u0435\u0442\u044C \u0432\u0445\u043E\u0434
      \u043E\u0442 \u043E\u0431\u0449\u0435\u0433\u043E \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430
      \n\u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u0442\u044C\u0441\u044F \u0441
      \u043A\u0430\u0440\u0442 \u201C\u0413\u043E\u0441\u0442\u0438\u043D\u0430\u044F\u201D
      \u0438\u043B\u0438 \u201C\u041A\u043E\u0440\u0438\u0434\u043E\u0440\u201D. "
    targetType: 3
    topPanelTargetType: 0
    bottomPanelTargetType: 0
    bottomPanelTargetRoom: {fileID: 0}
